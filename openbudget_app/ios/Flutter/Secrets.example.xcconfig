// Copy this file to Secrets.xcconfig (gitignored) and fill in the value.
//
// GOOGLE_REVERSED_CLIENT_ID is the REVERSED_CLIENT_ID from the iOS OAuth
// client's GoogleService-Info.plist. It is the iOS client id with its parts
// reversed:
//   com.googleusercontent.apps.<ios-client-id>
// The value must belong to the same iOS client id passed as GOOGLE_CLIENT_ID
// in config/dart_defines.local.json.

GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.YOUR_IOS_CLIENT_ID
