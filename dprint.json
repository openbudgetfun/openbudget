{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "incremental": true,
  "exec": {
    "commands": [
      {
        "command": "nixfmt",
        "exts": ["nix"]
      },
      {
        "command": "shfmt --filename {{file_path}} -i 0",
        "exts": ["sh", "bash"]
      },
      {
        "command": "dartfmt {{file_path}}",
        "exts": ["dart"]
      }
    ]
  },
  "json": {
    "indentWidth": 2,
    "useTabs": false
  },
  "markdown": {},
  "toml": {},
  "yaml": {
    "indentWidth": 2
  },
  "excludes": [
    "**/.dart_tool/**",
    "**/build/**",
    "**/.devenv*/**",
    "**/.direnv/**",
    "**/node_modules/**",
    "**/*.g.dart",
    "**/*.freezed.dart",
    "**/generated_protocol/**",
    "**/generated/**",
    "pubspec.lock",
    "**/pubspec.lock"
  ],
  "plugins": [
    "https://plugins.dprint.dev/json-0.21.1.wasm",
    "https://plugins.dprint.dev/markdown-0.21.1.wasm",
    "https://plugins.dprint.dev/toml-0.7.0.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.5.0.wasm"
  ]
}
